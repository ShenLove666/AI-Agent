# Copy this file to .env for local development. Never commit .env or real secrets.
# Production should inject secrets through the process manager/secret store instead.

APP_NAME=RAGent Python
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# SQLite is convenient for local development. Use a managed PostgreSQL/MySQL URL
# for production workloads and keep the database outside the release directory.
DB_URL=sqlite:///./data/ragent-v4-flash.db

# Replace with a random value (at least 32 bytes) before starting any shared or
# production instance. Do not use the placeholder as a real signing key.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
# 720 minutes = 12 hours. Set explicitly; the application fallback is longer.
JWT_EXPIRE_MINUTES=720

# Keep vector retrieval disabled unless the embedding model and Milvus runtime
# have been installed and validated on the target host.
VECTOR_BACKEND=disabled
EMBED_MODEL_PATH=
EMBED_DEVICE=cpu
EMBED_DIMENSION=512
MILVUS_URI=./data/milvus-ragent.db
MILVUS_TOKEN=
MILVUS_COLLECTION=ragent_chunks_v2
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
RERANK_CANDIDATE_LIMIT=20

RETRIEVAL_TIMEOUT_SECONDS=8
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_CONTEXT_LIMIT=6
PROMPT_HISTORY_TOKEN_BUDGET=3000
PROMPT_CONTEXT_TOKEN_BUDGET=4000
CHAT_TIMEOUT_SECONDS=120
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=20
CHAT_IDLE_TIMEOUT_SECONDS=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30

# Keep uploads on persistent storage with restrictive filesystem permissions.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_FILE_SIZE=52428800

# Configure at least one model endpoint for AI generation. Leave keys empty in
# this template and inject real values at runtime.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
VISION_MODEL=qwen3.7-plus
MIMO_BASE_URL=
MIMO_API_KEY=
MIMO_MODEL=
MIMO_CHAT_MODEL=
MIMO_REASONING_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-flash
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=
BACKUP_LLM_REASONING_MODEL=

# Outbound customer delivery is intentionally a demo/no-op by default.
CUSTOMER_CHANNEL=demo
CUSTOMER_WEBHOOK_URL=
CUSTOMER_WEBHOOK_SECRET=
CUSTOMER_WEBHOOK_TIMEOUT_SECONDS=5

# CLI-only demo seeding input; never reuse this password for real accounts.
DEMO_SEED_PASSWORD=

# Optional release metadata (CI/deployment can set these without a Git checkout).
GIT_COMMIT=
